# Server
PORT=5000

# MongoDB (local or Atlas connection string)
MONGODB_URI=mongodb://localhost:27017/fraudlens

# JWT
JWT_SECRET=your-super-secret-key-change-in-production
JWT_EXPIRES_IN=7d

# CORS - frontend URL
CORS_ORIGIN=http://localhost:3000

# Gemini AI (for "why legit / why fake" on result screen). Get key at https://aistudio.google.com/apikey
# GEMINI_API_KEY=your_key
# Or multiple keys (tried in order if one fails): GEMINI_API_KEYS=key1,key2

# Groq (fast LLM fallback for /api/gemini/explain and /api/scan/*). https://console.groq.com/keys
# GROQ_API_KEY=gsk_xxx
# Optional: GROQ_API_KEYS=key1,key2
# Primary model: GROQ_MODEL=llama-3.3-70b-versatile
# On rate limits / daily quota, the client tries additional models (built-in chain unless you set):
#   GROQ_MODEL_FALLBACKS=llama-3.1-8b-instant,qwen/qwen3-32b
# Or set the full order: GROQ_MODELS=model1,model2,model3

# Python ML API (fallback when Gemini fails or for /api/scan/* without Gemini). Default port 5001.
# ML_SERVICE_URL=http://127.0.0.1:5001

# Optional: Hugging Face Inference API token for explanation fallback (between Gemini and deterministic text).
# Get a free token at https://huggingface.co/settings/tokens
# HUGGINGFACE_API_TOKEN=hf_xxx
# HUGGINGFACE_EXPLAIN_MODEL=mistralai/Mistral-7B-Instruct-v0.2

# Google OAuth (same Client ID as frontend). Get at https://console.cloud.google.com/apis/credentials
# GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
